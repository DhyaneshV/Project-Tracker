# ─── Production Environment Template ─────────────────────────────
# Copy this to .env.production and fill in real values.
# NEVER commit .env.production to version control.
#
# For deployment, use AWS Secrets Manager or SSM Parameter Store
# to inject these at runtime rather than storing in files.

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_production_access_key
AWS_SECRET_ACCESS_KEY=your_production_secret_key

# DynamoDB
DYNAMODB_TABLE=ProjectTracker

# Application Secrets
JWT_SECRET=generate_a_new_64_byte_base64_string_for_production

# OAuth - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://api.yourdomain.com/auth/github/callback

# URLs
FRONTEND_URL=https://app.yourdomain.com
VITE_GATEWAY_URL=https://api.yourdomain.com/graphql
USERS_SERVICE_URL=https://users-lambda-url.amazonaws.com
PROJECTS_SERVICE_URL=https://projects-lambda-url.amazonaws.com
CHAT_SERVICE_URL=https://chat-lambda-url.amazonaws.com

# Email (AWS SES)
SES_FROM_EMAIL=noreply@yourdomain.com
SES_REGION=ap-south-1
