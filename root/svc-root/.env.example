# ─── AWS Configuration ───────────────────────────────────────────
# Create an IAM user with DynamoDB, SES, and S3 permissions
# NEVER commit real credentials. Use AWS Secrets Manager in production.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# ─── Service URLs (local dev) ────────────────────────────────────
USERS_SERVICE_URL=http://localhost:4001
PROJECTS_SERVICE_URL=http://localhost:4002
CHAT_SERVICE_URL=http://localhost:4003
CHAT_WS_URL=ws://localhost:4003

# ─── Application Secrets ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=generate_a_64_byte_random_base64_string

# ─── Frontend URL (for CORS) ─────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── OAuth (optional for local dev) ──────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# ─── Email (AWS SES) ─────────────────────────────────────────────
SES_FROM_EMAIL=noreply@yourdomain.com
SES_REGION=ap-south-1
